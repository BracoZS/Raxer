<Application x:Class="Raxer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Raxer"
             xmlns:shared="clr-namespace:Raxer.Infra.Shared"
             
             ShutdownMode="OnExplicitShutdown"
             xmlns:lang="clr-namespace:Raxer.Infra.Lang"
             >
    <Application.Resources>
   
        <ResourceDictionary>
            <!-- converters -->
            <shared:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <shared:NullToVisibilityConverter x:Key="NullToVisibility" />

            <ResourceDictionary.MergedDictionaries>
                <!-- UI text from resx -->
                <lang:ResxDictionary />
                <ResourceDictionary Source="/Modules/UI/Themes/Theme.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/TextBlockStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/CheckBoxStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/IconStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
        
    </Application.Resources>
</Application>

<Application x:Class="Raxer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Raxer"
             xmlns:shared="clr-namespace:Raxer.Infra.Shared"
             
              StartupUri="TestsWindow.xaml"
              ShutdownMode="OnExplicitShutdown"
             >
    <Application.Resources>
   
        <ResourceDictionary>
            <!-- converters -->
            <shared:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <shared:NullToVisibilityConverter x:Key="NullToVisibility" />
        </ResourceDictionary>
        
    </Application.Resources>
</Application>

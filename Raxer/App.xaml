<Application x:Class="Raxer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Raxer"
             xmlns:shared="clr-namespace:Raxer.Infra.Shared"
             
             ShutdownMode="OnExplicitShutdown"
             xmlns:lang="clr-namespace:Raxer.Infra.Lang"
             >
    <Application.Resources>
   
        <ResourceDictionary>
            <!-- converters -->
            <shared:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <shared:NullToVisibilityConverter x:Key="NullToVisibility" />

            <!-- UI text from resx -->
            <ResourceDictionary.MergedDictionaries>
                <lang:ResxDictionary />
            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
        
    </Application.Resources>
</Application>

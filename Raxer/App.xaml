<Application x:Class="Raxer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Raxer"
             xmlns:shared="clr-namespace:Raxer.Infra.Shared"
             
             ShutdownMode="OnExplicitShutdown"
             xmlns:lang="clr-namespace:Raxer.Infra.Lang"
             >
    <Application.Resources>
   
        <ResourceDictionary>
            <!-- converters -->
            <shared:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <shared:NullToVisibilityConverter x:Key="NullToVisibility" />

            <ResourceDictionary.MergedDictionaries>
                <!-- UI text from resx -->
                <lang:ResxDictionary />

                <!-- Design tokens (Palette is pulled in by Theme) -->
                <!--<ResourceDictionary Source="/Modules/UI/Tokens/Paleta.xaml" /> Theme.xaml:6 ya hace merge -->
                <ResourceDictionary Source="/Modules/UI/Tokens/Radios.xaml" />
                <ResourceDictionary Source="/Modules/UI/Tokens/Spacing.xaml" />
                <ResourceDictionary Source="/Modules/UI/Tokens/Typography.xaml" />

                <!-- Semantic theme -->
                <ResourceDictionary Source="/Modules/UI/Themes/Theme.xaml" />

                <!-- Component styles -->
                <ResourceDictionary Source="/Modules/UI/Styles/ButtonStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/TextBlockStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/CheckBoxStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/IconStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/ComboboxStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/BorderStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/PanelStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/RadioButtonStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/ScrollStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/SliderStyles.xaml" />
                <ResourceDictionary Source="/Modules/UI/Styles/PageStyles.xaml" />

            </ResourceDictionary.MergedDictionaries>

        </ResourceDictionary>
        
    </Application.Resources>
</Application>

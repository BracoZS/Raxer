<UserControl x:Class="Raxer.Modules.Settings.Pages.InfoPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             
             d:DesignWidth="445" 
             d:DesignHeight="426"
             Style="{StaticResource page}"
             Tag="{DynamicResource page-title-about}"
             >
    <UserControl.Background>
        <ImageBrush ImageSource="/Assets/Images/model-about.png" Stretch="Uniform" Opacity="0.0"/>
    </UserControl.Background>

    <StackPanel Margin="0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <TextBlock Text="Raxer"
                       Style="{StaticResource t_x}"
                       FontSize="15"
                       Foreground="{StaticResource info}"/>

            <TextBlock Text="Version del software: 2.0 "
                       Style="{StaticResource t_x}" FontStretch="UltraExpanded"
                       Margin="0,4,0,0"/>
            <TextBlock Text="©Copyright BracoZS "
                       Style="{StaticResource t_x}"
                       Margin="0,3,0,0"/>

            <TextBlock Style="{StaticResource t_x}"
                       TextWrapping="WrapWithOverflow"
                       Height="auto"
                       Margin="0,21,10,0"
                       LineHeight="17">
                Para mas información diríjase al sitio web del repositorio oficial:
                <Hyperlink Foreground="{StaticResource info}">https://github.com/BracoZS/Raxer</Hyperlink>
 Raxer is an app for remapping the mouse buttons, it supports:  left click, right click, mousewheel, backward, forward.
 If you want to be able to create a new mouse comportamietno, you can do it with Raxer. Works with any mouse, regardless of brand.Copyright @BracoZSWorks with any mouse, regardless of brand.Copyright @BracoZS
            </TextBlock>

        <TextBlock Text="Componentes adicionales"
                       Style="{StaticResource t_x}"
                       Foreground="{StaticResource info}"
                       Margin="0,11,0,0"/>

        <TextBlock Style="{StaticResource t_x}"
                       TextWrapping="Wrap"
                       Height="auto"
                       Margin="0,11,0,0" LineHeight="14">
                Some Library Name v12.
                <LineBreak/>
                Copyright @2004 Some Author Name
                <LineBreak/>
                <Hyperlink Foreground="{StaticResource info}">
                    MIT License
                </Hyperlink>
            </TextBlock>

            <TextBlock Style="{StaticResource t_x}"
                       TextWrapping="Wrap"
                       Height="auto"
                       Margin="0,11,0,0" LineHeight="14">

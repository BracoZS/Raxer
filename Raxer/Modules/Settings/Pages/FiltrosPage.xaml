<UserControl x:Class="Raxer.Modules.Settings.Pages.FiltrosPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             
             d:DesignWidth="445"
             d:DesignHeight="426"
             Style="{StaticResource page}"
             Tag="{DynamicResource page-title-filters}"
             Background="Transparent">

    <ListBox Margin="10"
             Background="Transparent"
             BorderBrush="Transparent"
             BorderThickness="0"
             ItemsSource="{Binding Filtros}"
             Foreground="{StaticResource text}">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource borde}" Width="400" Padding="10,5,10,0">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Titulo}" />
                                <Button Style="{StaticResource boton_menu}"
                                        HorizontalAlignment="Right" Height="16"/>
                            </Grid>
                            <TextBlock Text="{Binding Tipo}" Style="{StaticResource t_x}"
                               Margin="1,5,0,0"/>
                            <ListBox Background="Transparent"
                                     BorderBrush="Transparent"
                                     BorderThickness="0"
                                     ItemsSource="{Binding Apps}"
                                     Foreground="{StaticResource text}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Margin="-17,2,-7,0"/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>

                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Width="56" Height="56" Margin="11,0,0,0">
                                            <Image Source="/imgs/info.png" Margin="0,6,0,0" Width="28" Height="28"/>
                                            <TextBlock Text="{Binding}" Margin="0,3,0,0" TextWrapping="Wrap" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>

                            </ListBox>

                            <TextBlock Text="Vinculado a:" Margin="0,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding Links}"
                                  Style="{StaticResource perfiles_links}"
                                  Margin="-4,0,0,5"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>

        </ListBox>

</UserControl>

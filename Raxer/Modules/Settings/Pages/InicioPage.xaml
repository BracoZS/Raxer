<UserControl x:Class="Raxer.Modules.Settings.Pages.InicioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             
             d:DesignWidth="445"
             d:DesignHeight="426"
            
             Background="LightSlateGray"
             >

    <Grid Margin="4">
        <Grid.Background>
            <ImageBrush Stretch="Uniform"/>
        </Grid.Background>

        <!-- Base (redondeado abajo, derecha) -->
        <Border CornerRadius="0,0,8,0" 
               Grid.RowSpan="2">
        </Border>

        <!-- Título -->
        <StackPanel
           Height="30"
           Width="400"
           HorizontalAlignment="Left"
           VerticalAlignment="Top"
           Margin="11,2,0,0">
            <Canvas
               Height="29"
               Width="69"
               HorizontalAlignment="Left"
               VerticalAlignment="Center">
                <TextBlock
                   Text="Inicio"
                   Canvas.Left="11"
                   Canvas.Top="7"
                   Style="{StaticResource text.3}" />
            </Canvas>
            <Canvas>
                <Rectangle 
                   Height="1"
                   Width="54"
                   Fill="{StaticResource bg.geometry}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                <Rectangle
                   Height="1"
                   Width="417">
                    <Rectangle.Fill>
                        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                            <GradientStop Color="#00CDCDCD" Offset="0.95"/>
                            <GradientStop Color="#59F1F1F1" Offset="0"/>
                            <GradientStop Color="#59F1F1F1" Offset="0.85"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Canvas>
        </StackPanel>

        <!-- Cuerpo -->
        <DockPanel Margin="0,32,0,0">
            <!-- Top -->
            <Border Style="{StaticResource borde}"
                   DockPanel.Dock="Top"
                   Height="135"
                   Margin="13,15,0,0"
                   Padding="0,6,0,0">
                <Grid Width="399" >
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!-- Parte izquierda -->
                    <TextBlock Text="Perfil actual"
                              Grid.Row="0"
                              />
                    <TextBlock Text="Filtro"
                              Grid.Row="1"
                              />
                    <TextBlock Text="Archivo de configuración"
                              Grid.Row="2"
                              />
                    <TextBlock Text="Atajo para cambiar perfil"
                              Grid.Row="3"
                               TextAlignment="Justify" />
                    <CheckBox Style="{StaticResource casilla}"
                             Grid.Row="4"
                             Margin="10,-4,0,0"
                             Content="Activar notificaciones"
                             />
                    <TextBlock Grid.Row="5"
                              >
                       <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"
                                  Foreground="{StaticResource info}">
                           Configuracion adicional en sistema ↗
                       </Hyperlink>
                    </TextBlock>

                    <!-- Parte derecha -->
                    <TextBlock Text="Glorius 3X80CR"
                              Grid.Column="1"
                              Grid.Row="0"
                              />
                    <TextBlock Text="Office aplications"
                              Grid.Column="1"
                              Grid.Row="1"
                              />
                    <TextBlock Text="C:\Settings\ConfigFiles.rxconfig"
                              Grid.Column="1"
                              Grid.Row="2"
                              />
                    <TextBlock Text="Control + R  +  >"
                              Grid.Column="1"
                              Grid.Row="3"
                              />
                </Grid>
            </Border>

            <!-- Left -->
            <StackPanel DockPanel.Dock="Left"
                       Margin="13,12,0,0">

                <!-- 1 -->
                <Border Style="{StaticResource borde}"
                       Width="285"
                       Height="79">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Velocidad del puntero"
                                  />
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock 
                                      Text="Lenta" Margin="10,0,17,0"/>
                            <Slider Style="{StaticResource slider}"/>
                            <TextBlock 
                                      Text="Rapida" Margin="14,0,0,0"/>
                        </StackPanel>
                        <CheckBox 
                                 Content="Mejora de precisión"
                                 Margin="10,5,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 2 -->
                <Border 
                       Width="285"
                       Height="120"
                       Margin="0,11,0,0" Visibility="Collapsed">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Text="Visibilidad"
                                  />
                        <CheckBox 
                                 Content="Mejora de precisión"
                                 Margin="10,5,0,0"/>
                        <CheckBox
                                 Content="Mostrar rastro"
                                 Margin="10,7,0,0"/>
                        <CheckBox 
                                 Margin="10,7,0,0" Height="33">
                            <TextBlock TextWrapping="Wrap"
                                      Text="Sonar. Muestra la ubicación del puntero al presionar la tecla  ‘Control’"/>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- 3 -->
                <Border Style="{StaticResource borde}"
                       Width="285"
                       Height="285"
                       Margin="0,11,0,0" >
                    <StackPanel Margin="0,8,0,8">
                        <TextBlock Text="Velocidad del puntero"
                                  />
                        <CheckBox Style="{StaticResource casilla}"
                                 Content="Activar"
                                 Margin="10,5,0,0"/>
                        <TextBlock Text="Presione durante el tiempo indicado para poder arrastrar  sin mantener presionado el boton del mouse. Vuelva a hacer clic para liberar."
                                  
                                  TextWrapping="Wrap"
                                  Height="auto"
                                  Margin="10,11,0,0" Visibility="Collapsed"/>
                        <TextBlock Text="Tiempo antes de bloquear"
                                  
                                  Margin="10,10,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                            <TextBlock 
                                       Text="Corto" Margin="10,0,17,0"/>
                            <Slider Style="{StaticResource slider}"/>
                            <TextBlock 
                                       Text="Largo" Margin="14,0,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Right -->
            <Border Style="{StaticResource borde}"
                   Width="104"
                   Height="320"
                   DockPanel.Dock="Right"
                   Margin="11,12,0,0">
                <DockPanel Margin="10,8,10,0">

                    <TextBlock Style="{StaticResource t_x}"
                              Text="Apariencia"
                              DockPanel.Dock="Top"
                              Margin="0,0,0,11"/>

                    <StackPanel Width="50"
                               DockPanel.Dock="Left">
                        <TextBlock Text="Normal" />
                        <TextBlock Text="Arrow"/>
                        <TextBlock Text="Ayuda" />
                        <TextBlock Text="2° plano" />
                        <TextBlock Text="Ocupado" />
                        <TextBlock Text="Texto" />
                        <TextBlock Text="Vinculo" />
                        <TextBlock Text="Normal" />
                    </StackPanel>

                    <StackPanel Width="24" HorizontalAlignment="Right">
                        <TextBlock Text="💉"   HorizontalAlignment="Center"/>
                        <TextBlock Text="💉"   HorizontalAlignment="Center"/>
                        <TextBlock Text="💉"   HorizontalAlignment="Center"/>
                        <TextBlock Text="💉"   HorizontalAlignment="Center"/>
                        <TextBlock Text="💉"   HorizontalAlignment="Center"/>
                        <TextBlock Text="💉"   HorizontalAlignment="Center"/>
                        <TextBlock Text="💉"   HorizontalAlignment="Center"/>
                    </StackPanel>
                </DockPanel>
            </Border>

        </DockPanel>
    </Grid>

    <!--
    <StackPanel Margin="24,16,24,8">
        <TextBlock Text="{DynamicResource app-name}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource text}" />
        <TextBlock Text="{DynamicResource tagline}" FontSize="13" Foreground="{StaticResource text}" Margin="0,2,0,20" />

        <Border Background="{StaticResource bg.surface}"
                BorderBrush="{StaticResource border}" BorderThickness="1"
                CornerRadius="8" Padding="20,16"
                VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="{DynamicResource settings}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource text}" />
                <CheckBox Content="{DynamicResource start-with-windows}"
                          IsChecked="{Binding ArrancarConWindows}"
                          Foreground="{StaticResource text}"
                          FontSize="13"
                          Margin="0,16,0,0" />
            </StackPanel>
        </Border>
    </StackPanel>
    -->

</UserControl>

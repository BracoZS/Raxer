<Window x:Class="Raxer.Modules.Settings.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Raxer.Modules.Settings"
        mc:Ignorable="d"
        
        Height="450" Width="800"
        Title="{DynamicResource settings}"
        >

    <Window.Resources>
        <SolidColorBrush x:Key="Fondo" Color="#e6e5ee" />
        <SolidColorBrush x:Key="Panel" Color="#f4f4f6" />
        <SolidColorBrush x:Key="PanelHover" Color="#232B35" />
        <SolidColorBrush x:Key="Borde" Color="#2A323D" />
        <SolidColorBrush x:Key="Texto" Color="#1a1a1a" />
        <SolidColorBrush x:Key="TextoSuave" Color="#8A93A0" />
        <SolidColorBrush x:Key="Acento" Color="#4D9DE0" />
    </Window.Resources>

    <Grid
     Background="{StaticResource Fondo}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Borde}" BorderThickness="0,0,1,0">
            <!-- vacio x ahora -->
        </Border>

        <!-- Contenido -->
        <Grid Grid.Column="1" Margin="36,32,36,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <TextBlock Text="{DynamicResource app-name}" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Texto}" />
                <TextBlock Text="{DynamicResource tagline}" FontSize="14" Foreground="{StaticResource TextoSuave}" Margin="0,2,0,24" />
            </StackPanel>

            <!-- Card de settings -->
            <Border Grid.Row="1"
                 Background="{StaticResource Panel}"
                 BorderBrush="{StaticResource Borde}" BorderThickness="1"
                 CornerRadius="10" Padding="24,20"
                 VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="{DynamicResource settings}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Texto}" />
                    <CheckBox x:Name="IniciarConWindowsCheck"
                            Content="{DynamicResource start-with-windows}"
                           IsChecked="False"
                           Foreground="{StaticResource Texto}"
                           FontSize="14"
                           Margin="0,20,0,0" />
                    <!--<TextBlock Text="{DynamicResource abcd}"/>-->
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>

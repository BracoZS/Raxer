<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fondo general -->
    <SolidColorBrush x:Key="Fondo" Color="#e6e5ee" />

    <!-- Paneles y tarjetas -->
    <SolidColorBrush x:Key="Panel" Color="#f4f4f6" />
    <SolidColorBrush x:Key="PanelHover" Color="#232B35" />

    <!-- Bordes -->
    <SolidColorBrush x:Key="Borde" Color="#2A323D" />

    <!-- Texto -->
    <SolidColorBrush x:Key="Texto" Color="#1a1a1a" />
    <SolidColorBrush x:Key="TextoSuave" Color="#8A93A0" />

    <!-- Acento -->
    <SolidColorBrush x:Key="Acento" Color="#4D9DE0" />

    <!-- Barra de título -->
    <SolidColorBrush x:Key="TituloBarra" Color="#252525" />

    <!-- Sidebar -->
    <SolidColorBrush x:Key="Sidebar" Color="#2D2D2D" />

    <!-- Botones de ventana -->
    <SolidColorBrush x:Key="BotonControl" Color="#3A3A3A" />
    <SolidColorBrush x:Key="BotonControlHover" Color="#505050" />
    <SolidColorBrush x:Key="BotonCerrar" Color="#E81123" />
    <SolidColorBrush x:Key="BotonCerrarHover" Color="#FF4D57" />

</ResourceDictionary>

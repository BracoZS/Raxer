<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Layout completo de página + fade/slide al entrar.
         La página solo aporta: Tag (título), Background y el cuerpo. -->
    <Style x:Key="page" TargetType="{x:Type UserControl}">
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform X="0" Y="0"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type UserControl}">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Base redondeado abajo, derecha -->
                        <Border Grid.RowSpan="2"
                                CornerRadius="0,0,8,0"
                                Background="{TemplateBinding Background}"/>

                        <!-- Encabezado: título + línea divisoria -->
                        <StackPanel Grid.Row="0"
                                    Height="30"
                                    Margin="14,3,0,0" 
                                    Width="NaN"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Top">
                            <StackPanel HorizontalAlignment="Left">
                                <TextBlock Text="{TemplateBinding Tag}"
                                           Margin="11,7,11,0"
                                           Style="{StaticResource text.3}"/>
                                <Rectangle Height="1"
                                           Margin="0,6,0,0"
                                           HorizontalAlignment="Stretch"
                                           Fill="{StaticResource bg.geometry}"/>
                            </StackPanel>
                            <Rectangle Height="1" Margin="11,1,0,0">
                                <Rectangle.Fill>
                                    <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                                        <GradientStop Color="#00CDCDCD" Offset="0.95"/>
                                        <GradientStop Color="#59F1F1F1" Offset="0"/>
                                        <GradientStop Color="#59F1F1F1" Offset="0.85"/>
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </StackPanel>

                        <!-- Cuerpo con scroll -->
                        <ScrollViewer Grid.Row="1"
                                      Style="{StaticResource scroll}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      CanContentScroll="False"
                                      Padding="16,14">
                            <ContentPresenter/>
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Style.Triggers>
            <Trigger Property="Visibility" Value="Collapsed">
                <Setter Property="Opacity" Value="0"/>
            </Trigger>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                         From="0"
                                         To="1"
                                         Duration="0:0:0.2"/>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                         From="50"
                                         To="0"
                                         DecelerationRatio="0.5"
                                         Duration="0:0:0.07"/>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>

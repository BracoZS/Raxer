<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="slider" TargetType="Slider">
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="20" />
        <Setter Property="TickFrequency" Value="1" />
        <Setter Property="IsSnapToTickEnabled" Value="True" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Width" Value="163" />
        <Setter Property="Value" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Border Padding="0,0,4,0" BorderBrush="Transparent"  BorderThickness="1">
                        <Grid>
                            <!-- Línea de fondo -->
                            <Rectangle Height="1"
                                  Stroke="{StaticResource border.sutil}"
                                  Margin="3,0,4,0"/>

                            <!-- Marcas de progreso -->
                            <Path Data="M 1,0 2,0"
                                 Stretch="Fill"
                                 StrokeThickness="6"
                                 StrokeDashArray="0.2 2.3"
                                 Stroke="{StaticResource text.muted}"
                                 HorizontalAlignment="Center"
                                 Margin="0,0,0,0"/>

                            <Track x:Name="PART_Track">
                                <Track.Thumb>
                                    <Thumb Name="PART_Thumb" Width="7" Height="14" >
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <!-- Triángulo como Thumb -->
                                                <Path Fill="{StaticResource icon}"
                                                 Data="M0,0 L3.5,7 7,0 Z"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
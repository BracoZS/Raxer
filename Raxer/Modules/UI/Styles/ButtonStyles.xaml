<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Button styles go here -->

    <Style x:Key="boton_control" TargetType="{x:Type Button}">
        <!--tamaño-->
        <Setter Property="Height" Value="29" />
        <Setter Property="Width" Value="35" />

        <!--diseño-->
        <Setter Property="Foreground" Value="{StaticResource texto}"/>
        <Setter Property="Margin" Value="0,2,2,2"/>

        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="borde"
                            Background="{StaticResource bg.surface}"
                            CornerRadius="5">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde"
                                    Property="Background"
                                    Value="{StaticResource bg.surface.1}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="boton_control_x" TargetType="{x:Type Button}" BasedOn="{StaticResource boton_control}">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="borde"
                            Background="{StaticResource bg.surface}"
                            CornerRadius="5">
                        <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="borde"
                                    Property="Background"
                                    Value="{StaticResource danger}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="boton_implement" TargetType="{x:Type Button}">
        <!--tamaño-->
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="77"/>
        <!--diseño-->
        <Setter Property="Foreground" Value="{StaticResource bg.surface}"/>
        <Setter Property="Margin" Value="4"/>

        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="base"
                            CornerRadius="5"
                            BorderThickness="1"
                            BorderBrush="{StaticResource border}"
                            Background="{StaticResource bg.surface.1}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="presentador"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,1.5,0,0"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="base" Property="BorderThickness" Value="1"/>
                            <Setter TargetName="base" Property="Background" Value="{StaticResource bg.surface.1}"/>
                            <Setter TargetName="base" Property="BorderBrush" Value="{StaticResource border.over}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Margin" Value="4,5,4,4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="boton_menu" TargetType="{x:Type Button}">

        <Setter Property="Background" Value="{x:Null}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Content" Value="•••"/>
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource text}"/>
        <!-- aqui height es width -->
        <Setter Property="Height" Value="16"/>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <RotateTransform Angle="90" CenterX="1" CenterY="1"/>
            </Setter.Value>
        </Setter>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <Style x:Key="boton_menu_del" TargetType="{x:Type Button}" BasedOn="{StaticResource boton_menu}">
        <Setter Property="Foreground" Value="{StaticResource danger}"/>
        <Setter Property="Content" Value="❌"/>
    </Style>


</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="sidebar-item" TargetType="RadioButton">
        <Setter Property="Margin" Value="1,4,1,0"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="borde"
                        Width="67"
                        Height="60"
                        CornerRadius="5"
                        BorderThickness="0"
                        BorderBrush="{StaticResource border.sutil}">
                        <Border.Background>
                            <SolidColorBrush x:Name="BorderBackground"
                                             Color="Transparent"/>
                        </Border.Background>

                        <Grid>
                            <Border Name="indicador"
                                    Width="2"
                                    Height="35"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource border}"
                                    CornerRadius="1"
                                    Visibility="Collapsed"
                                    BorderThickness="0"/>
                            <ContentPresenter
                                VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="indicador"
                                    Property="Visibility" Value="Visible"/>
                            <Setter TargetName="borde"
                                    Property="BorderThickness" Value="1"/>
                            <Setter TargetName="borde"
                                    Property="BorderBrush" Value="{StaticResource border.active}"/>
                            <Setter TargetName="borde"
                                    Property="Background" Value="{StaticResource bg.surface.1}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="indicador"
                                    Property="Visibility" Value="Visible" />
                            <Setter TargetName="borde"
                                    Property="BorderThickness" Value="1" />
                            <Setter TargetName="borde"
                                    Property="BorderBrush" Value="{StaticResource border.over}" />
                            <Setter TargetName="borde" Property="Background" Value="{StaticResource bg.surface.1}" />
                        </Trigger>

                        <EventTrigger RoutedEvent="Border.MouseLeftButtonDown" SourceName="borde">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="indicador"
                                                     Storyboard.TargetProperty="(Border.Height)"
                                                     To="31"
                                                     Duration="0:0:0.5" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="Button.PreviewMouseLeftButtonUp">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="indicador"
                                                     Storyboard.TargetProperty="(Border.Height)"
                                                     To="35"
                                                     Duration="0:0:0.5" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
<Window x:Class="Raxer.TestsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Raxer"
        xmlns:controls="clr-namespace:Raxer.Controls"
        mc:Ignorable="d"
        Title="Raxer" Height="480" Width="620"
        
        WindowStartupLocation="CenterScreen"
        FontFamily="Assets/Fuentes/#Rubik" Closed="Window_Closed">

    <Window.Resources>
        <!--<SolidColorBrush x:Key="Fondo" Color="#e6e5ee" />
        <SolidColorBrush x:Key="Panel" Color="#f4f4f6" />
        <SolidColorBrush x:Key="PanelHover" Color="#232B35" />
        <SolidColorBrush x:Key="Borde" Color="#2A323D" />
        <SolidColorBrush x:Key="Texto" Color="#1a1a1a" />
        <SolidColorBrush x:Key="TextoSuave" Color="#8A93A0" />
        <SolidColorBrush x:Key="Acento" Color="#4D9DE0" />-->

    </Window.Resources>

    <Grid Margin="14" Background="Black">
        <controls:NumericUpDown
                                Value="12"
                                Minimum="0"
                                Maximum="20"
                                SmallChange="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
        
        <TextBlock Width="150" Height="25" VerticalAlignment="Bottom" Margin="100"
               Text="holaaaaaaa" Background="Transparent"/>

        <CheckBox  Content="{DynamicResource section-visibility}" Margin="175,71,242,320"/>
        <TextBlock Text="‘Control’" Margin="114,0,0,0" />
        <HeaderedContentControl
                Header="x"
                Width="285"
                Margin="0,11,0,0"
                Visibility="Visible">
        </HeaderedContentControl>

        <!--Eso cierra el misterio por completo. Ahora todo cuadra:
        Causa raíz unificada
        d:Visibility="Visible" corrompe la resolución de DynamicResource en el diseñador. 
        No importa en qué elemento esté: el simple hecho de combinar
        un DynamicResource y d:Visibility en la misma ventana revienta la resolución
        y sale el azul "no se pudo resolver el recurso".
        Y cuando no había ningún DynamicResource cerca, d:Visibility solo tumbaba el render del surface
        (lo del checkbox externo).-->

    </Grid>
</Window>
